{
  "name": "math-fasters-trailer",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "record": "tsx record.ts",
    "music": "tsx music.ts",
    "studio": "remotion studio src/index.ts",
    "render:trailer": "remotion render src/index.ts Trailer out/math-fasters-trailer.mp4 --codec=h264 --crf=21",
    "render:loop": "remotion render src/index.ts Loop out/loop.mp4 --codec=h264 --crf=20 --muted",
    "render:poster": "remotion still src/index.ts Trailer out/poster.jpg --frame=180 --image-format=jpeg --jpeg-quality=85",
    "render:gif": "remotion ffmpeg -y -loglevel error -i out/loop.mp4 -r 12 -filter_complex \"scale=480:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=128:stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4:diff_mode=rectangle\" out/math-fasters.gif",
    "publish": "mkdir -p ../docs/trailer && cp out/math-fasters-trailer.mp4 out/math-fasters.gif out/poster.jpg ../docs/trailer/",
    "render": "pnpm record && pnpm music && pnpm render:trailer && pnpm render:loop && pnpm render:poster && pnpm render:gif && pnpm run publish"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "playwright": "1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
